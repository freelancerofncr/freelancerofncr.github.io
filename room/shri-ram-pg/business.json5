{
  // =================================================
  // BASIC IDENTITY (TOP SECTION)
  // =================================================
  identity: {
    name: "Shri Ram PG",

    // Short description (1-3 lines recommended)
    description: "Affordable PG near metro for students and working professionals with modern amenities",

    // boys | girls | both
    genderType: "both",

    // Suitable for: Students, Working Professionals, Families, Couples, Bachelors
    suitableFor: [
      "Students",
      "Working Professionals",
      "Families",
      "Couples",
    ],
  },

  // =================================================
  // BRANDING (LOGO)
  // =================================================
  branding: {
    showLogo: true,            // true | false
    logoImage: "logo.webp",    // Place file at: photos/logo.webp
  },

  // =================================================
  // CONTACT (MULTIPLE NUMBERS SUPPORTED)
  // =================================================
  contact: {
    primaryCall: "+919650000000",

    // Optional: Add more contact numbers
    otherNumbers: [
      "+919811111111",
      "+919822222222",
    ],

    whatsapp: "+919650000000",
  },

  // =================================================
  // LOCATION
  // =================================================
  location: {
    addressShort: "Sector 104, Noida, Uttar Pradesh",
    mapLink: "https://maps.google.com/",
  },

  // =================================================
  // SOCIAL / EXTERNAL LINKS
  // Leave empty "" to auto-hide on website
  // =================================================
  socialLinks: {
    instagram: "https://www.instagram.com/",
    facebook: "https://www.facebook.com/",
    youtube: "https://www.youtube.com/",
    website: "https://www.youtube.com/",
  },

  // =================================================
  // PROPERTY INFORMATION
  // =================================================
  property: {
    // PG | Rooms | Flat | Building
    type: "PG",

    totalFloors: 5,

    liftAvailable: true,
    
    parkingAvailable: true,
  },

  // =================================================
  // COMMON FACILITIES (PROPERTY-LEVEL AMENITIES)
  // These are shared facilities available for all residents
  // =================================================
  commonFacilities: [
    "Lift",
    "Washing Machine",
    "Fridge",
    "RO Water",
    "Power Backup",
    "Parking",
    "CCTV",
    "Housekeeping",
    "WiFi",
    "AC",
    // "Security Guard",
    // "Water Dispenser",
  ],

  // =================================================
  // FOOD SYSTEM
  // =================================================
  food: {
    // true = food available | false = no food
    available: true,

    // If food is charged separately (leave empty "" if included in rent)
    price: "₹2,499/Month",

    // Free text for timing/schedule
    note: "Mon–Fri: 2 times, Sat–Sun: 3 times",
    // Examples: "3 meals daily", "Self cooking allowed", "Breakfast + Dinner"
  },

  // =================================================
  // ELECTRICITY / WATER / MAINTENANCE CHARGES
  // =================================================
  charges: {
    electricityIncluded: false,
    electricityRate: "₹10/unit",

    waterIncluded: true,       // true | false
    maintenanceIncluded: true, // true | false
  },

  // =================================================
  // PAYMENT QR (UPI / RENT COLLECTION)
  // Place QR image at: photos/qr.webp
  // =================================================
  payment: {
    show: true,                 // true | false
    label: "Pay Rent via UPI",
    qrImage: "qr.webp",         // photos/qr.webp
  },

  // =================================================
  // ROOMS CONFIGURATION
  // Photo naming: single1.webp, single2.webp (prefix: "single")
  // =================================================
  rooms: [
    {
      type: "Single Room",
      prefix: "single",       // Photo prefix for auto-loading
      price: "₹9,000",

      // Room-specific facilities (NOT property-level)
      roomFacilities: [
        "Bed",
        "Almirah",
        "Mattress",
        "Attached Bathroom",
        "Balcony",
        "Kitchen Access",
        // "AC",
      ],
    },

    {
      type: "Double Sharing",
      prefix: "double",
      price: "₹6,000",

      roomFacilities: [
        "Bed",
        "Almirah",
        "Mattress",
        "Common Bathroom",
      ],
    },

    {
      type: "1 BHK",
      prefix: "1bhk",
      price: "₹14,000",

      roomFacilities: [
        "Kitchen",
        "Balcony",
        "Attached Bathroom",
        "Bed",
        "Wardrobe",
      ],
    },
  ],

  // =================================================
  // RULES / POLICIES (OPTIONAL)
  // Add house rules here - will auto-hide if empty
  // =================================================
  rules: [
    "No alcohol or smoking inside premises",
    "Entry after 10 PM not allowed",
    "Security deposit: 50% of monthly rent",
    "1 month notice required before vacating",
    // "Guests allowed with prior permission",
    // "Maintain cleanliness in common areas",
  ],

}
