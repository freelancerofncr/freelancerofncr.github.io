
// =============================================================
// BUSINESS CONFIGURATION FILE (JSON5 FORMAT)
// Comments allowed
// YES / NO system enabled
// All master controls in one place
// =============================================================

{
  // ===========================================================
  // MASTER CONTROL PANEL (TURN SECTIONS ON / OFF HERE)
  // ===========================================================
  controls: {
    header: "YES",
    contact: "YES",
    services: "YES",
    social: "YES",
    platforms: "YES",
    payment: "YES",
    googleReview: "YES",
    search: "YES",
    vegToggle: "YES",
    categoryNav: "YES",
    requireTableNumber: "YES",
    minimumDeliveryOrder: 499
  },

  // ===========================================================
  // RESTAURANT IDENTITY
  // foodType options:
  // "veg"     → Pure Veg
  // "nonveg"  → Pure Non-Veg
  // "mix"     → Veg & Non-Veg
  // ===========================================================
  identity: {
    name: "Demo Royal Bistro",
    categoryLine: "Indian • Chinese • Italian • Fast Food",
    foodType: "mix",
    logo: "assets/logo.png"
  },

  // ===========================================================
  // CONTACT SECTION (Write "NO" to hide any field)
  // ===========================================================
  contact: {
    primaryPhone: "+91 9999999999",
    secondaryPhone: "+91 8888888888",
    whatsappNumber: "+91 9999999999",
    email: "demo@royalbistro.com"
  },

  // ===========================================================
  // LOCATION
  // If fullAddress = "NO" → Address hidden
  // ===========================================================
  location: {
    fullAddress: "2nd Floor, Demo Plaza, Sector 78, Noida 201305",
    googleMapLink: "https://maps.google.com"
  },

  // ===========================================================
  // SERVICES (YES / NO)
  // ===========================================================
  services: {
    delivery: "YES",
    dineIn: "YES",
    takeaway: "YES"
  },

  // ===========================================================
  // ONLINE DELIVERY PLATFORMS
  // Write link OR "NO"
  // ===========================================================
  platforms: {
    swiggy: "https://www.swiggy.com",
    zomato: "https://www.zomato.com",
    eatsure: "NO",
    uberEats: "NO"
  },

  // ===========================================================
  // SOCIAL MEDIA (Only icons shown)
  // Write link OR "NO"
  // ===========================================================
  social: {
    instagram: "https://instagram.com",
    facebook: "https://facebook.com",
    youtube: "https://youtube.com",
    twitterX: "https://x.com",
    threads: "NO",
    snapchat: "NO",
    google: "https://g.page",
    website: "https://example.com"
  },

  // ===========================================================
  // GOOGLE REVIEW BUTTON
  // ===========================================================
  googleReview: {
    enabled: "YES",
    link: "https://g.page/review"
  },

  // ===========================================================
  // PAYMENT SECTION
  // ===========================================================
  payment: {
    enabled: "YES",
    qrImage: "assets/payment.png",
    upiId: "demobistro@upi"
  },

  // ===========================================================
  // OPENING HOURS (Live badge will use today's timing only)
  // ===========================================================
  openingHours: {
    monday:    { open: "11:00", close: "23:00", closed: "NO" },
    tuesday:   { open: "11:00", close: "23:00", closed: "NO" },
    wednesday: { open: "11:00", close: "23:00", closed: "NO" },
    thursday:  { open: "11:00", close: "23:00", closed: "NO" },
    friday:    { open: "11:00", close: "23:59", closed: "NO" },
    saturday:  { open: "10:00", close: "23:59", closed: "NO" },
    sunday:    { open: "10:00", close: "23:00", closed: "NO" }
  }

}
